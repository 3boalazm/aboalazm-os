{
  "name": "aboalazm-os",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Mustafa Aboalazm OS — Personal Design Operating System",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run test:blob-token && npm run test:work-projects && npm run test:case-claims && npm run test:business-cases && npm run test:cms-text && npm run test:conversion && npm run test:brand-consistency && npm run test:lead-pipeline && npm run test:og-trace && npm run test:positioning && npm run test:discoverability && npm run test:studio && npm run test:schema-audit && npm run test:analytics-events && npm run test:case-ms && npm run test:bundle-guards && npm run test:android-assetlinks && npm run typecheck && npm run db:migrate:ci && next build && npm run check:db-ssl && npm run check:db-schema",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:blob-token": "node --import tsx --test lib/blob-token.test.ts",
    "test:work-projects": "node --import tsx --test features/work/project-curation.test.ts",
    "test:case-claims": "node --import tsx --test features/case-studies/reviewed-claims.test.ts",
    "test:business-cases": "node --import tsx --test features/case-studies/business-cases.test.ts",
    "test:case-ms": "node --import tsx --test features/case-studies/ms/ms.test.ts",
    "test:bundle-guards": "node --import tsx --test lib/bundle-guards.test.ts",
    "test:android-assetlinks": "node --import tsx --test lib/android-assetlinks.test.ts",
    "test:cms-text": "node --import tsx --test lib/cms-text.test.ts",
    "test:conversion": "node --import tsx --test lib/conversion.test.ts",
    "test:brand-consistency": "node --import tsx --test lib/contact-brand-consistency.test.ts",
    "test:lead-pipeline": "node --import tsx --test lib/contact-attribution.test.ts",
    "test:og-trace": "node --import tsx --test lib/og-trace.test.ts",
    "test:positioning": "node --import tsx --test lib/positioning.test.ts",
    "test:discoverability": "node --import tsx --test lib/discoverability.test.ts",
    "test:studio": "node --import tsx --test lib/studio/studio.test.ts",
    "test:analytics-events": "node --import tsx --test lib/analytics-events.test.ts",
    "test:schema-audit": "node --import tsx --test lib/payload-schema-audit.test.ts",
    "check:contact": "node --import tsx scripts/check-contact-setup.ts",
    "check:db-ssl": "node --import tsx scripts/check-db-ssl-mode.ts",
    "payload": "payload",
    "check:migrations": "payload migrate:status",
    "db:migrate": "node --import tsx scripts/run-payload-migrations.ts --apply",
    "db:migrate:ci": "node --import tsx scripts/run-payload-migrations.ts --vercel-production-only",
    "check:db-schema": "node --import tsx scripts/check-payload-schema-state.ts",
    "baseline:migrations": "node --import tsx scripts/baseline-payload-migrations.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.5.19",
    "@payloadcms/db-postgres": "3.85.2",
    "@payloadcms/next": "3.85.2",
    "@payloadcms/richtext-lexical": "3.85.2",
    "@payloadcms/storage-vercel-blob": "3.85.2",
    "@payloadcms/ui": "3.85.2",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.9.0",
    "graphql": "16.14.2",
    "gsap": "^3.12.7",
    "lenis": "^1.2.3",
    "lexical": "0.41.0",
    "next": "15.4.11",
    "next-sanity": "^11.6.0",
    "nodemailer": "^10.0.10",
    "opentype.js": "1.3.5",
    "payload": "3.85.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/opentype.js": "1.3.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3"
  }
}
