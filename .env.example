# Payload CMS — required in every environment (local, Vercel Preview, Production)
DATABASE_URI=
PAYLOAD_SECRET=

# ── Contact-form email notifications (optional but recommended) ───────────
# Submissions are ALWAYS stored in the `messages` collection; when SMTP is
# configured they are ALSO emailed to CONTACT_NOTIFY_TO. Leave SMTP unset and
# the site still works — the email is skipped with a log line.
#
# Option A — Gmail (needs an App Password: Google Account → Security →
# 2-Step Verification → App passwords; a normal password will NOT work):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
#
# Option B — Resend (resend.com, free tier; no Gmail security hoops):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional override for the From header (defaults to SMTP_USER). With Gmail
# this must be the authenticated account's address.
SMTP_FROM=
# Where submissions are delivered.
CONTACT_NOTIFY_TO=m1aboalazm@gmail.com

# NOTE: every NEXT_PUBLIC_* variable in this file is inlined at BUILD time. After
# changing one in Vercel, redeploy — a restart is not enough.
#
# Canonical origin used for sitemap.xml, robots.txt, canonical/og:image URLs and
# JSON-LD. This project uses its stable Vercel project domain.
NEXT_PUBLIC_SITE_URL=https://aboalazm-os.vercel.app

# ── Android Trusted Web Activity (TWA) ───────────────────────────────────────
# Confirmed package id: com.aboalazm.os (do not change after publishing).
# Set SHA-256 fingerprints only after signing keys exist.
# Include the local/upload signing certificate AND the Play App Signing certificate,
# comma-separated in colon-delimited SHA-256 form. This is public certificate data,
# not a password or private key. Without valid fingerprints /.well-known/assetlinks.json
# intentionally returns 503 rather than serving a fake/placeholder association.
ANDROID_SHA256_CERT_FINGERPRINTS=

# Vercel Blob storage for media uploads (production)
BLOB_READ_WRITE_TOKEN=

# ── Deposit Flow (/book) — Payment methods (optional; only set vars are shown) ──
# When none of the four methods below is set, /book automatically shows:
# "Ask me for payment details on WhatsApp".
# NEXT_PUBLIC_PAYPAL_ME and NEXT_PUBLIC_PAYMOB_LINK must be full https:// links
# (e.g. https://paypal.me/yourname); anything else is shown as plain text.
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=
NEXT_PUBLIC_WALLET_HOLDER_NAME=
NEXT_PUBLIC_INSTAPAY_ADDRESS=
NEXT_PUBLIC_PAYPAL_ME=
NEXT_PUBLIC_PAYMOB_LINK=

# ── EGP & SAR Exchange Rate Helper (optional; valid for 7 days) ────────────────
# NEXT_PUBLIC_EGP_PER_USD: numeric rate (e.g. 50). SAR uses the official 3.75 peg.
# NEXT_PUBLIC_FX_VALID_UNTIL: ISO date (e.g. 2026-11-07). If unset or expired,
# prices fall back automatically to "EGP/SAR confirmed on WhatsApp".
NEXT_PUBLIC_EGP_PER_USD=
NEXT_PUBLIC_FX_VALID_UNTIL=

# ── Discovery Call Booking Link (optional; hidden when unset) ──────────────────
# Cal.com or Google appointment URL for "Book a free 30-min call". Must start with
# https:// — any other value hides the link.
NEXT_PUBLIC_BOOKING_URL=


# Studio console (local verification only).
# Set to 1 to skip Payload schema push under NODE_ENV=development — needed
# when running against a database built from migrations, because the push
# generator cannot build this schema at all (docs/studio/03_SCHEMA_FINDINGS.md).
# Leave unset everywhere else.
PAYLOAD_DISABLE_PUSH=
